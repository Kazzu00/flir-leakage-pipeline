          "type": "number"
        },
        "per_split": {
          "default": 12,
          "maximum": 50,
          "minimum": 1,
          "title": "Per Split",
          "type": "integer"
        },
        "refine_radius": {
          "default": 0.3,
          "exclusiveMinimum": 0,
          "maximum": 2,
          "title": "Refine Radius",
          "type": "number"
        },
        "seed": {
          "default": 20261103,
          "title": "Seed",
          "type": "integer"
        },
        "selection_archive": {
          "default": "Imagenes.zip",
          "title": "Selection Archive",
          "type": "string"
        },
        "top_k": {
          "default": 5,
          "maximum": 10,
          "minimum": 2,
          "title": "Top K",
          "type": "integer"
        }
