        "control_evidence_locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control Evidence Locator"
        },
        "control_evidence_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
