# Local environment, credentials and tooling
.env
.env.*
!.env.example
.venv/
.venv-*/
__pycache__/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.cache/
.coverage*
htmlcov/
dist/
build/
*.egg-info/
*.pem
*.key
credentials*.json

# Real datasets and annotations stay outside Git; placeholders only
data/**
!data/**/
!data/**/.gitkeep
datasets/
labels/
images/
videos/
*.zip
*.tar
*.gz
*.tgz
*.rar
*.7z
*.jpg
*.jpeg
*.png
*.bmp
*.tif
*.tiff
*.webp
*.mp4
*.mov
*.avi
*.mkv

# Weights, model caches, embeddings and inventories
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.bin
*.npy
*.npz
*.parquet
*.arrow
models/
model_cache/
hf_cache/
artifacts/
mlruns/

# All generated reports are local, including code review and executed notebooks
reports/**
!reports/**/
!reports/**/.gitkeep
*.executed.ipynb
*.html
